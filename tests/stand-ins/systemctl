#!/bin/sh
# Stand-in systemd (systemctl --user): remembers the units started, as systemd-UNIT in $FAKE_STATE.
# Each start counts in $FAKE_STATE/pid (the fake health's pid).
started() { touch "$FAKE_STATE/systemd-$1"; echo $(($(cat "$FAKE_STATE/pid" 2>/dev/null || echo 1) + 1)) >"$FAKE_STATE/pid"; }
echo "systemctl $*" >>"$FAKE_LOG"
[ "$1" = --user ] && shift
case $1 in
enable) [ "$2" = --now ] && started "$3" ;;
disable) [ "$2" = --now ] && rm -f "$FAKE_STATE/systemd-$3" ;;
start | restart) started "$2" ;;
stop) rm -f "$FAKE_STATE/systemd-$2" ;;
is-active)
  u=$2
  [ "$u" = --quiet ] && u=$3
  if [ -e "$FAKE_STATE/systemd-$u" ]; then [ "$2" = --quiet ] || echo active
  else [ "$2" = --quiet ] || echo inactive; exit 3; fi ;;
esac
exit 0
