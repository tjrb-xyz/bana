#!/bin/sh
# Stand-in launchd: remembers what was bootstrapped. FAKE_BOOTOUT_SLOW=N: a service booted
# out stays loaded for N more prints (the daemon still stops). Each start counts in
# $FAKE_STATE/pid (the fake health's pid). A file $FAKE_STATE/start-fail: the next start
# fails, once.
echo "launchctl $*" >>"$FAKE_LOG"
case $1 in
bootstrap)
  if [ -e "$FAKE_STATE/start-fail" ]; then
    rm -f "$FAKE_STATE/start-fail"
    echo "Bootstrap failed: 5: Input/output error" >&2
    exit 5
  fi
  touch "$FAKE_STATE/launchd-$(basename "$3" .plist)"
  echo $(($(cat "$FAKE_STATE/pid" 2>/dev/null || echo 1) + 1)) >"$FAKE_STATE/pid" ;;
bootout)
  if [ -n "${FAKE_BOOTOUT_SLOW:-}" ] && [ -e "$FAKE_STATE/launchd-${2##*/}" ]; then
    echo "$FAKE_BOOTOUT_SLOW" >"$FAKE_STATE/stopping-${2##*/}"
  else
    rm -f "$FAKE_STATE/launchd-${2##*/}"
  fi ;;
print)
  s=$FAKE_STATE/stopping-${2##*/}
  if [ -e "$s" ]; then
    n=$(cat "$s")
    if [ "$n" -gt 0 ]; then echo $((n - 1)) >"$s"; else rm -f "$s" "$FAKE_STATE/launchd-${2##*/}"; fi
  fi
  [ -e "$FAKE_STATE/launchd-${2##*/}" ] ;;
esac
