#!/bin/sh
# Stand-in act: records how bana calls it, and its pid and environment in $FAKE_STATE;
# FAKE_ACT_SLEEP=N keeps it running N seconds (as the same pid). It prints FAKE_ACT_OUT, and
# exits with FAKE_ACT_EXIT, saying so on stderr as act does. With FAKE_ACT_INT=1 (trapped
# before FAKE_ACT_OUT), a SIGINT ends it as it ends act: a last line a moment later (tee must
# still be there to take it), then exit 1.
# bana add's dry runs (-n -j JOB, maybe --matrix K:V): a skip line for each label in
# $FAKE_STATE/labels/JOB (JOB@K:V for an entry); with -v, $FAKE_STATE/matrix/JOB as act's
# matrix line.
echo "act $*" >>"$FAKE_LOG"
[ "$1" != --version ] || { echo "act version 0.2.89"; exit 0; }
# act -l: FAKE_ACT_LIST as its table (none by default), and nothing else: bana ci's view lists
# the jobs while act runs, and must not take its pid or environment here. act -l -j JOB:
# $FAKE_STATE/list/JOB, when there is one.
if [ "$1" = -l ]; then
  j='' prev=''
  for a in "$@"; do [ "$prev" != -j ] || j=$a; prev=$a; done
  if [ -n "$j" ] && [ -f "$FAKE_STATE/list/$j" ]; then cat "$FAKE_STATE/list/$j"
  elif [ -n "${FAKE_ACT_LIST:-}" ]; then printf '%s\n' "$FAKE_ACT_LIST"; fi
  exit 0
fi
# lib/systemd.sh's probe (a label on bana-systemd-probe): FAKE_ACT_PROBE as its output, and
# FAKE_ACT_PROBE_EXIT; its arguments in act.probe.
case " $* " in
*"=bana-systemd-probe "*)
  echo "$*" >>"$FAKE_STATE/act.probe"
  [ -z "${FAKE_ACT_PROBE:-}" ] || printf '%s\n' "$FAKE_ACT_PROBE"
  exit "${FAKE_ACT_PROBE_EXIT:-0}" ;;
esac
# In a systemd container (tests/stand-ins/docker, FAKE_IN_CONTAINER): its arguments in act.inner,
# its environment in act.inner.env; FAKE_ACT_OUT_SYSD on stdout, FAKE_ACT_ERR_SYSD on stderr,
# then FAKE_ACT_SLEEP_SYSD seconds, and FAKE_ACT_EXIT_SYSD. FAKE_ACT_INT (or FAKE_ACT_INT_SYSD,
# for this act only) as below; FAKE_ACT_INT_SYSD=2: the first SIGINT is noted (int in
# act.inner.int) and act goes on, the second ends it, as act's force stop does.
# FAKE_ACT_LATE as below, too.
if [ -n "${FAKE_IN_CONTAINER:-}" ]; then
  echo "$*" >>"$FAKE_STATE/act.inner"
  env >"$FAKE_STATE/act.inner.env"
  n=0 s=''
  case ${FAKE_ACT_INT_SYSD:-${FAKE_ACT_INT:-}} in
  '') ;;
  2) trap 'n=$((n + 1)); echo int >>"$FAKE_STATE/act.inner.int"; [ "$n" -lt 2 ] || { kill "$s" 2>/dev/null; echo "act: forced to stop, in its container"; exit 1; }' INT ;;
  *) trap 'kill "$s" 2>/dev/null; sleep 0.2; echo "act: interrupted, in its container"; echo int >>"$FAKE_STATE/act.inner.int"; exit 1' INT ;;
  esac
  [ -z "${FAKE_ACT_OUT_SYSD:-}" ] || printf '%s\n' "$FAKE_ACT_OUT_SYSD"
  [ -z "${FAKE_ACT_ERR_SYSD:-}" ] || printf '%s\n' "$FAKE_ACT_ERR_SYSD" >&2
  if [ -n "${FAKE_ACT_SLEEP_SYSD:-}" ]; then
    sleep "$FAKE_ACT_SLEEP_SYSD" &
    s=$!
    # A trap that lets act go on: it waits for the sleep again.
    while kill -0 "$s" 2>/dev/null; do wait "$s" || :; done
  fi
  if [ -n "${FAKE_ACT_LATE:-}" ]; then
    while [ ! -e "$FAKE_STATE/late" ]; do sleep 0.05; done
    echo '{"msg":"late, in its container"}'
    echo "late, in its container" >&2
    echo inner >>"$FAKE_STATE/act.survived"
  fi
  exit "${FAKE_ACT_EXIT_SYSD:-0}"
fi
if [ -d "$FAKE_STATE/labels" ]; then
  job='' entry='' verbose='' dry='' prev=''
  for a in "$@"; do
    case $prev in -j) job=$a ;; --matrix) entry="$entry@$a" ;; esac
    case $a in -v) verbose=1 ;; -n) dry=1 ;; esac
    prev=$a
  done
  if [ -n "$dry" ] && [ -n "$job" ]; then
    if [ -n "$verbose" ] && [ -f "$FAKE_STATE/matrix/$job" ]; then
      echo "time=\"2026-09-30T10:00:00Z\" level=debug msg=\"Final matrix after applying user inclusions '$(cat "$FAKE_STATE/matrix/$job")'\""
    fi
    [ ! -f "$FAKE_STATE/labels/$job$entry" ] ||
      while IFS= read -r l; do
        echo "*DRYRUN* [ci/$job] 🚧  Skipping unsupported platform -- Try running with \`-P $l=...\`"
      done <"$FAKE_STATE/labels/$job$entry"
    exit 0
  fi
fi
# bana ci's fetch of the actions (a dry run, one job at a time): nothing more.
case " $* " in *" -n --concurrent-jobs 1 "*) echo "$*" >>"$FAKE_STATE/act.fetch"; exit 0 ;; esac
echo "$$" >"$FAKE_STATE/act.pid"
env >"$FAKE_STATE/act.env"
[ -z "${FAKE_ACT_INT:-}" ] || trap 'kill "$s" 2>/dev/null; sleep 0.2; echo "act: interrupted, its containers removed"; exit 1' INT
[ -z "${FAKE_ACT_OUT:-}" ] || printf '%s\n' "$FAKE_ACT_OUT"
if [ -n "${FAKE_ACT_INT:-}" ]; then
  # In the background, so that a SIGINT to act alone (the daemon's) ends it at once.
  sleep "${FAKE_ACT_SLEEP:-30}" &
  s=$!
  wait "$s"
elif [ -n "${FAKE_ACT_SLEEP:-}" ]; then
  exec sleep "$FAKE_ACT_SLEEP"
fi
# FAKE_ACT_LATE=1: once $FAKE_STATE/late exists, a line on each output, then act.survived.
if [ -n "${FAKE_ACT_LATE:-}" ]; then
  while [ ! -e "$FAKE_STATE/late" ]; do sleep 0.05; done
  echo '{"msg":"late"}'
  echo "late" >&2
  echo ok >>"$FAKE_STATE/act.survived"
fi
[ "${FAKE_ACT_EXIT:-0}" = 0 ] || { echo "Error: Job 'rust' failed" >&2; exit "$FAKE_ACT_EXIT"; }
